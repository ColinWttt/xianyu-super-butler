# docker-compose.cloud.yml 用的环境变量模板：复制成 .env 再改。
# 注意：只有这里列出的项会被代码读取。仓库另几份 compose 里的
# AUTO_REPLY_ENABLED / AI_REPLY_ENABLED / SESSION_TIMEOUT / HEARTBEAT_* 等
# 在 Python 侧没有 os.getenv 调用，真正生效的开关在 global_config.yml。

# 首次建库时初始化的管理员密码，登录后立刻在
# 「设置 → 账号与同步 → 修改登录密码」改掉；库已存在时改这里无效。
ADMIN_PASSWORD=change-me-before-start

TZ=Asia/Shanghai
WEB_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# 2 GiB 主机保持 1536M；4 GiB 主机改成 3072M。
MEMORY_LIMIT=1536M
MEMORY_RESERVATION=512M
CPU_LIMIT=2.0
CPU_RESERVATION=0.5

# 云服务器上留空会让日志里的人工验证链接指向 172.x 容器内网地址，
# 填公网 IP 或域名，例如 butler.example.com 或 1.2.3.4。
SERVER_HOST=

# SQLite 语句日志在云上是多余的磁盘与 CPU 开销，默认关掉。
SQL_LOG_ENABLED=false
SQL_LOG_LEVEL=WARNING
